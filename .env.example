# Copy this file to .env and adjust. Real environment variables override these values.

# development | production  (production refuses to start without a secret key)
RAILMATE_ENV=development

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
RAILMATE_SECRET_KEY=

# Comma-separated origins allowed to call the API from other sites (empty = same-origin only)
RAILMATE_CORS_ORIGINS=

# Requests per minute per IP for /api routes (0 disables). Login/register are limited to 10/min.
RAILMATE_RATE_LIMIT=120

# Login session length in minutes
RAILMATE_TOKEN_MINUTES=120

RAILMATE_LOG_LEVEL=INFO

# Optional path overrides
# RAILMATE_DB_PATH=data/railmate.db
# RAILMATE_USER_DB_PATH=var/users.db
# RAILMATE_MODEL_PATH=ml/artifacts/delay_model.joblib
